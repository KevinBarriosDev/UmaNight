<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>UmaNight</AssemblyName>
    <Product>Uma Night</Product>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Icono: assets\custom.ico si existe (local, ignorado por git); si no, el icono original -->
  <PropertyGroup>
    <AppIconFile Condition="Exists('assets\custom.ico')">assets\custom.ico</AppIconFile>
    <AppIconFile Condition="'$(AppIconFile)' == ''">assets\umamusumedarkmode.ico</AppIconFile>
    <ApplicationIcon>$(AppIconFile)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="$(AppIconFile)" Link="assets\app.ico" />
    <None Include="$(AppIconFile)" Link="assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>